# =============================================================
# Nexus AI Environment Configuration Template
# Copy this file to .env and configure your keys
# =============================================================

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# LLM Provider Key (OpenAI, Groq, OpenRouter, DeepSeek)
# Groq keys (gsk_...) automatically route to Groq with ultra-fast inference
OPENAI_API_KEY=gsk_your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_MODEL=qwen/qwen3.8-27b

# Real-Time Web Grounding (Optional - DuckDuckGo is active as zero-cost fallback)
TAVILY_API_KEY=

# Image Generation ('pollinations' for free FLUX.1 or 'openai' for DALL-E 3)
IMAGE_PROVIDER=pollinations
